<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so101_web_teleop</name>
  <version>0.1.0</version>
  <description>IMU-based web teleop for SO101: phone browser streams orientation via rosbridge to control the arm using inverse kinematics.</description>
  <maintainer email="scx@gapp.nthu.edu.tw">Nimrod</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>ament_index_python</depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- rosbridge provides the WebSocket ↔ ROS bridge -->
  <exec_depend>rosbridge_server</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
